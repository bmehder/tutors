{
  "name": "christian-tutors",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#booking/session-time": "./src/lib/session-time.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run build:planner && astro dev --host 127.0.0.1 --port 5200",
    "build": "npm run build:planner && tsc --noEmit && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.mjs temp-reference/typescript/tests/*.test.mjs",
    "build:planner": "node scripts/build-planner.mjs",
    "test:parity": "npm run build:planner && node --experimental-strip-types --test tests/parity/*.test.mjs",
    "test:email": "node --env-file=.env.local --experimental-strip-types tests/email-delivery.integration.mjs",
    "test:limits": "node --env-file=.env.local --experimental-strip-types tests/request-limits.integration.mjs",
    "test:site": "node --experimental-strip-types scripts/check-public-pages.mjs",
    "test:checkout": "node --env-file=.env.local --experimental-strip-types tests/checkout.integration.mjs",
    "test:browser": "npm run build:planner && node --env-file=.env.local --experimental-strip-types tests/browser/walkthrough.mjs",
    "test:operations": "node --env-file=.env.local --experimental-strip-types tests/email-operations.integration.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^10.0.8",
    "@js-temporal/polyfill": "^0.5.1",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "astro": "^6.4.8",
    "pg": "^8.23.1",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "esbuild": "0.27.7",
    "playwright": "^1.65.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
