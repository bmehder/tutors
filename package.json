{
  "name": "christian-tutors",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run build:planner && astro dev --host 127.0.0.1",
    "build": "npm run build:planner && tsc --noEmit && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.mjs temp-reference/typescript/tests/*.test.mjs",
    "build:planner": "node scripts/build-planner.mjs",
    "test:parity": "npm run build:planner && node --experimental-strip-types --test tests/parity/*.test.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "astro": "^6.4.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "22.19.19",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
