---
import PublicLayout from '../layouts/PublicLayout.astro'
import HeroSection from '../components/home/HeroSection.astro'
import HowItWorksSection from '../components/home/HowItWorksSection.astro'
import MyFunScienceSection from '../components/home/MyFunScienceSection.astro'
import BookingIsland from '../components/home/BookingIsland.astro'
import TutorsSection from '../components/home/TutorsSection.astro'
import TestimonialsSection from '../components/home/TestimonialsSection.astro'
// import NewsletterSignup from '../components/home/NewsletterSignup.astro'
import FaqSection from '../components/home/FaqSection.astro'
import ContactSection from '../components/home/ContactSection.astro'
import { tutorHours } from '../server/tutor-hours'
import { siteUrl } from '../lib/seo'

export const prerender = false
Astro.response.headers.set('Cache-Control', 'no-store')
const featuredTutors = await tutorHours()
	.then(tutors => tutors.slice(0, 4))
	.catch(() => [])
---

<PublicLayout structuredData={[{
  '@type': 'Service',
  '@id': `${siteUrl}/#tutoring`,
  name: 'Christian online tutoring for homeschool families',
  serviceType: 'One-on-one online tutoring',
  description: 'Families choose a 5-, 10-, or 20-hour package and plan one-hour weekly tutoring sessions. The 10- and 20-hour packages can be shared across students and subjects.',
  url: `${siteUrl}/#booking`,
  provider: { '@id': `${siteUrl}/#organization` },
}]}>
	<main>
		<HeroSection />
		<HowItWorksSection />
		<BookingIsland />
		<TutorsSection tutors={featuredTutors} />
		<TestimonialsSection />
		<!-- Newsletter signup is paused; restore this component when ready.
		<NewsletterSignup />
		-->
		<FaqSection />
		<ContactSection />
		<MyFunScienceSection />
	</main>
</PublicLayout>
