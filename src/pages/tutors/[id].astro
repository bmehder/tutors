---
import SiteLayout from '../../layouts/SiteLayout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import TutorContact from '../../components/tutors/TutorContact.astro'
import { formatTime } from '../../lib/session-time'
import { tutorHours } from '../../server/tutor-hours'

export const prerender = false
Astro.response.headers.set('Cache-Control', 'no-store')
const tutor = (await tutorHours())
  .find(item => item.profileSlug === Astro.params.id)
if (!tutor) Astro.response.status = 404
const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']
function startRanges(times: number[]) {
  const ranges: { first: number; last: number }[] = []
  for (const time of [...new Set(times)].sort((a, b) => a - b)) {
    const previous = ranges.at(-1)
    if (previous && time === previous.last + 15) previous.last = time
    else ranges.push({ first: time, last: time })
  }
  return ranges.map(({ first, last }) =>
    first === last ? formatTime(first) : `${formatTime(first)}–${formatTime(last)}`,
  )
}
const availability = tutor?.startsByDay.flatMap((times, index) =>
  times.length ? [{ day: days[index], ranges: startRanges(times) }] : [],
) ?? []
---
<SiteLayout title={tutor?.name ?? 'Tutor not found'} description={tutor && `Find out what ${tutor.name} teaches and see their weekly tutoring hours.`}>
  <SiteHeader />
  <main class="mx-auto max-w-7xl px-6 pb-20 pt-8 md:px-12">
    <a href="/tutors" class="text-sm font-bold underline underline-offset-4">Back to all tutors</a>
    {tutor ? (
      <>
        <header class="my-6 border-b border-ink/15 pb-7">
          <h1 class="text-4xl font-semibold md:text-6xl">{tutor.name}</h1>
          <p class="serif mt-2 text-lg text-ink/80">One-on-one tutoring. Grounded in faith.</p>
          <ul aria-label="Subjects" class="mt-4 flex flex-wrap gap-2">
            {tutor.subjects.map(subject => <li class="rounded-full bg-[#edf3ed] px-3 py-1 text-sm">{subject}</li>)}
          </ul>
        </header>
        <div class:list={["grid items-start gap-8", import.meta.env.DEV && "lg:grid-cols-[minmax(0,1fr)_minmax(18rem,25rem)]"]}>
          <div class="min-w-0 space-y-8">
            <section aria-labelledby="about-tutor">
              <h2 id="about-tutor" class="text-2xl font-semibold">About {tutor.name}</h2>
              <p class="mt-2 text-xs font-semibold text-ink/70">Sample biography</p>
              <p class="mt-3 max-w-prose leading-7 text-ink/80">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
              <h3 class="mt-5 font-semibold">What a session can cover</h3>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-ink/80">
                <li>Work through a concept or assignment together</li>
                <li>Practice skills and review what needs more attention</li>
                <li>Set a focus for the next session</li>
              </ul>
            </section>
            <section aria-labelledby="tutor-availability" class="rounded-2xl border border-ink/15 bg-[#f0f2eb] p-5 md:p-7">
              <h2 id="tutor-availability" class="text-2xl font-semibold">Weekly start times</h2>
              <p class="mt-2 text-sm leading-6 text-ink/75">Start times are in Eastern time. Ranges offer starts every 15 minutes. Check the planner for open dates.</p>
              {availability.length ? (
                <dl class="mt-4 divide-y divide-ink/15">
                  {availability.map(({day, ranges}) => (
                    <div class="grid items-baseline gap-2 py-3 sm:grid-cols-[7rem_1fr]">
                      <dt class="font-semibold">{day}</dt>
                      <dd>
                        <ul class="flex flex-wrap gap-2">
                          {ranges.map(range => <li class="rounded-md border border-ink/10 bg-white px-3 py-1 text-sm font-medium">{range}</li>)}
                        </ul>
                      </dd>
                    </div>
                  ))}
                </dl>
              ) : <p class="mt-4 text-sm">No weekly hours are listed yet.</p>}
              <a href={`/?tutor=${encodeURIComponent(tutor.id)}#booking`} class="btn mt-5">Check dates and plan</a>
            </section>
          </div>
          {import.meta.env.DEV && <TutorContact tutorId={tutor.id} tutorName={tutor.name} />}
        </div>
      </>
    ) : (
      <div class="mt-6">
        <h1 class="text-4xl font-semibold">Tutor not found</h1>
        <p class="mt-3">This profile may have been removed from the directory.</p>
      </div>
    )}
  </main>
  <SiteFooter />
</SiteLayout>
