---
import SiteLayout from '../../layouts/SiteLayout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import TutorCard from '../../components/tutors/TutorCard.astro'
import { tutorHours } from '../../server/tutor-hours'

export const prerender = false
Astro.response.headers.set('Cache-Control', 'no-store')
const tutors = (await tutorHours())
tutors.sort((left, right) => left.name.localeCompare(right.name))
const subjects = [...new Set(tutors.flatMap(tutor => tutor.subjects))].sort((a, b) => a.localeCompare(b))
const subject = Astro.url.searchParams.get('subject') ?? ''
const matches = subject ? tutors.filter(tutor => tutor.subjects.includes(subject)) : tutors
---
<SiteLayout title="Our tutors" description="Browse tutors by subject and see their weekly tutoring hours.">
  <SiteHeader />
  <main class="mx-auto max-w-7xl px-6 pb-20 pt-8 md:px-12">
    <div class="max-w-2xl">
      <p class="eyebrow mb-3 text-ink/55">Our tutors</p>
      <h1 class="text-4xl font-semibold md:text-6xl">Personal attention.<br /><span class="serif">Shared values.</span></h1>
      <p class="mt-4 leading-7 text-ink/75">Find a Christian tutor who teaches your student’s subject. Check their weekly hours or ask a question before you book.</p>
    </div>
    <form method="get" action="/tutors" class="mt-8 flex flex-wrap items-end gap-3 border-y border-ink/15 py-4">
      <label class="grid w-full max-w-xs gap-1 text-sm font-semibold">
        Subject
        <select name="subject" class="field font-normal">
          <option value="">All subjects</option>
          {subjects.map(name => <option value={name} selected={subject === name}>{name}</option>)}
        </select>
      </label>
      <button type="submit" class="btn">Filter tutors</button>
      {subject && <a href="/tutors" class="px-2 py-3 text-sm underline underline-offset-4">Clear filter</a>}
    </form>
    <p class="mb-4 mt-6 text-sm text-ink/70">{matches.length} {matches.length === 1 ? 'tutor' : 'tutors'}{subject ? ` teaching ${subject}` : ''}</p>
    {matches.length === 0 && <p class="rounded-xl border border-ink/15 bg-white p-5">No tutors match this subject. <a class="underline" href="/tutors">See all tutors</a>.</p>}
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {matches.map(tutor => <TutorCard tutor={tutor} />)}
    </ul>
  </main>
  <SiteFooter />
</SiteLayout>
