---
import PublicLayout from '../../layouts/PublicLayout.astro'
import TutorCard from '../../components/tutors/TutorCard.astro'
import TutoringHelp from '../../components/TutoringHelp.astro'
import { publicTutoringTopics } from '../../server/public-topics'
import { siteUrl } from '../../lib/seo'
import { tutoringTopics } from '../../lib/tutoring-topics'

export const prerender = false
Astro.response.headers.set('Cache-Control', 'no-store')
const knownSubject = tutoringTopics.some(topic => topic.slug === Astro.params.slug)
const topic = knownSubject ? (await publicTutoringTopics()).find(topic => topic.slug === Astro.params.slug) : undefined
if (!topic) Astro.response.status = 404
const url = `${siteUrl}/subjects/${encodeURIComponent(Astro.params.slug ?? '')}`
const structuredData = topic ? [{
  '@type': 'Service', name: topic.title, description: topic.introduction, url,
  serviceType: `${topic.name} online tutoring`, provider: { '@id': `${siteUrl}/#organization` },
}, {
  '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl + '/' },
    { '@type': 'ListItem', position: 2, name: 'Subjects', item: siteUrl + '/subjects' },
    { '@type': 'ListItem', position: 3, name: topic.name, item: url },
  ],
}] : []
---
<PublicLayout title={topic?.title ?? 'Subject not found'} description={topic?.description} structuredData={structuredData}>
  <main class="mx-auto max-w-7xl px-6 pb-20 pt-8 md:px-12">
    <a href="/subjects" class="text-sm font-bold underline underline-offset-4">All tutoring subjects</a>
    {topic ? <>
      <header class="my-7 max-w-3xl">
        <p class="eyebrow mb-3 text-ink/55">One-on-one support. Shared Christian values.</p>
        <h1 class="text-4xl font-semibold md:text-5xl">{topic.title}</h1>
        <p class="mt-5 leading-7 text-ink/75">{topic.introduction}</p>
        <a href="/#booking" class="btn mt-6">Choose your package</a>
      </header>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <section class="rounded-xl border border-ink/15 bg-white p-6 md:p-8">
          <h2 class="text-2xl font-semibold">What you can work on together</h2>
          <ul class="mt-4 list-disc space-y-3 pl-5 leading-7 text-ink/80">{topic.focus.map(item => <li>{item}</li>)}</ul>
        </section>
        <section class="rounded-xl border border-ink/15 bg-[#f0f2eb] p-6 md:p-8">
          <h2 class="text-2xl font-semibold">What to bring to a session</h2>
          <ul class="mt-4 list-disc space-y-3 pl-5 leading-7 text-ink/80">{topic.bring.map(item => <li>{item}</li>)}</ul>
          <p class="mt-5 text-sm leading-7 text-ink/70">Share what your student is working on and what feels difficult. You can ask a tutor about your material before choosing a package.</p>
        </section>
      </div>
      <section class="mt-12" aria-labelledby="subject-tutors">
        <h2 id="subject-tutors" class="text-3xl font-semibold">Meet your {topic.name} tutors</h2>
        {topic.subjects.length > 0 && <p class="mt-3 leading-7 text-ink/75">Related subjects in our directory: {topic.subjects.join(', ')}.</p>}
        {topic.tutors.length > 0
          ? <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{topic.tutors.map(tutor => <TutorCard tutor={tutor} />)}</ul>
          : <p class="mt-4">No tutors are currently listed for this subject. <a href="/#contact" class="font-bold underline">Contact us</a> to discuss what you need.</p>}
        <TutoringHelp />
      </section>
      <section class="mx-auto mt-12 max-w-3xl" aria-labelledby="subject-questions">
        <h2 id="subject-questions" class="mb-5 text-3xl font-semibold">Questions about {topic.name} tutoring</h2>
        {topic.questions.map(([question, answer]) => <details class="border-b border-ink/15 py-4"><summary class="cursor-pointer font-semibold">{question}</summary><p class="mt-3 leading-7 text-ink/75">{answer}</p></details>)}
        <p class="mt-6 leading-7">One family plan can include different students, subjects, tutors, and weekly routines. <a href="/#booking" class="font-bold underline underline-offset-4">Compare packages and plan your tutoring</a>.</p>
      </section>
    </> : <section class="mt-7"><h1 class="text-4xl font-semibold">Subject not found</h1><p class="mt-4">Explore the <a href="/subjects" class="underline">tutoring subjects</a> or <a href="/tutors" class="underline">browse tutors</a> to find the help you need.</p></section>}
  </main>
</PublicLayout>
