---
import PublicLayout from '../../layouts/PublicLayout.astro'
import TutoringHelp from '../../components/TutoringHelp.astro'
import { publicTutoringTopics } from '../../server/public-topics'
import { siteUrl } from '../../lib/seo'

export const prerender = false
Astro.response.headers.set('Cache-Control', 'no-store')
const topics = await publicTutoringTopics()
---
<PublicLayout title="Christian Online Tutoring Subjects" description="Explore Algebra, Biology, Writing, and English tutoring for homeschool students. Find Christian tutors and plan one-on-one support for your family." structuredData={[{
  '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl + '/' },
    { '@type': 'ListItem', position: 2, name: 'Subjects', item: siteUrl + '/subjects' },
  ],
}]}>
  <main class="mx-auto max-w-7xl px-6 pb-20 pt-8 md:px-12">
    <p class="eyebrow mb-3 text-ink/55">Subjects for their needs</p>
    <h1 class="max-w-3xl text-4xl font-semibold md:text-6xl">A subject to work on.<br /><span class="serif">A person to work with.</span></h1>
    <p class="mt-5 max-w-2xl leading-7 text-ink/75">Start with the material your student is studying. Explore these subjects, meet the tutors who teach them, and choose weekly tutoring times that fit your family.</p>
    <ul class="mt-10 grid gap-5 md:grid-cols-3">
      {topics.map(topic => (
        <li class="flex flex-col rounded-xl border border-ink/15 bg-white p-6 md:p-7">
          <h2 class="text-2xl font-semibold"><a class="hover:underline" href={`/subjects/${topic.slug}`}>{topic.name} tutoring</a></h2>
          <p class="mt-4 flex-1 text-sm leading-7 text-ink/75">{topic.introduction}</p>
          <a class="mt-6 inline-flex min-h-11 w-fit items-center font-bold underline underline-offset-4" href={`/subjects/${topic.slug}`}>Explore {topic.name}</a>
        </li>
      ))}
    </ul>
    <section class="mt-10 rounded-xl border border-ink/15 bg-[#f0f2eb] p-6">
      <h2 class="text-2xl font-semibold">Looking for another subject?</h2>
      <p class="mt-3 leading-7 text-ink/75">Our tutor directory also includes other math, science, language, history, and related subjects. <a href="/tutors" class="font-bold underline underline-offset-4">Browse all tutors by subject</a>.</p>
      <TutoringHelp />
    </section>
  </main>
</PublicLayout>
