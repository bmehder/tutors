---
import { createHmac, timingSafeEqual } from 'node:crypto'
import { getSecret } from 'astro:env/server'
import { pool, tutorHours } from '../server/tutor-hours'
import { editBooking } from '../server/admin-bookings'
import { editSubject } from '../server/admin-subjects'
import { subjectCatalog } from '../server/subjects'
import { randomUUID } from 'node:crypto'
import { enforceRequestLimit, requestAddress, RequestLimitError } from '../server/request-limits'
import '../index.css'

export const prerender = false
Astro.response.headers.set('Cache-Control', 'no-store')
const email = getSecret(import.meta.env.DEV ? 'BOOKING_DEV_ADMIN_EMAIL' : 'BOOKING_ADMIN_EMAIL')
const password = getSecret(import.meta.env.DEV ? 'BOOKING_DEV_ADMIN_PASSWORD' : 'BOOKING_ADMIN_PASSWORD')
const signingKey = getSecret('BOOKING_ADMIN_SIGNING_KEY') ?? (import.meta.env.DEV ? password : undefined)
const enabled = !!signingKey && !!email && !!password && !!pool
if (!enabled) return new Response('Not found', { status: 404 })

const sign = (value: string) =>
	createHmac('sha256', signingKey!).update('private-admin:' + value).digest('hex')
const equal = (a: string, b: string) =>
	timingSafeEqual(Buffer.from(sign(a), 'hex'), Buffer.from(sign(b), 'hex'))
const cookie = 'booking_admin'
const [expiry, signature] = (Astro.cookies.get(cookie)?.value ?? '').split('.')
const signedIn =
	!!signature && Number(expiry) > Date.now() && equal(signature, sign(expiry))
const timeTravelDemo = import.meta.env.DEV
const days = [
	'Monday',
	'Tuesday',
	'Wednesday',
	'Thursday',
	'Friday',
	'Saturday',
	'Sunday',
]
const subjects = signedIn ? await subjectCatalog(pool) : []
const subjectNames = subjects.map(subject => subject.name)
const instructions = new Map(signedIn ? (await pool!.query<{ tutor_id: string; meeting_instructions: string; contact_email: string | null }>(
	'SELECT tutor_id, meeting_instructions, contact_email FROM tutor_profiles',
)).rows.map(row => [row.tutor_id, row]) : [])
const catalog = signedIn ? await tutorHours(true, pool, subjects) : []
const selected =
	catalog.find(t => t.id === Astro.url.searchParams.get('tutor')) ?? catalog[0]
const times = Array.from({ length: 97 }, (_, index) => index * 15)
function blocks(starts: number[]) {
	const ranges: { start: number; end: number }[] = []
	for (const start of starts) {
		const last = ranges.at(-1)
		if (last && start === last.end - 45) last.end = start + 60
		else ranges.push({ start, end: start + 60 })
	}
	return ranges
}
const wantsJson = Astro.request.headers.get('accept')?.includes('application/json')
const redirect = (url: string, status: 303) =>
	wantsJson ? Response.json({ ok: true }) : Astro.redirect(url, status)
let error = ''

if (Astro.request.method === 'POST') {
	if (Astro.request.headers.get('origin') !== Astro.url.origin)
		return new Response('Forbidden', { status: 403 })
	const form = await Astro.request.formData()
	const action = form.get('action')
	if (action === 'sign-in') {
		let permitted = true
		try {
			await enforceRequestLimit(pool!, 'admin-login', requestAddress(Astro))
		} catch (issue) {
			permitted = false
			Astro.response.status = issue instanceof RequestLimitError ? 429 : 503
			if (issue instanceof RequestLimitError) Astro.response.headers.set('Retry-After', String(issue.retryAfterSeconds))
			error = issue instanceof RequestLimitError ? issue.message : 'Sign-in is temporarily unavailable. Please try again shortly.'
		}
		if (
			permitted &&
			equal(String(form.get('email')), email!) &&
			equal(String(form.get('password')), password!)
		) {
			const expires = String(Date.now() + 3_600_000)
			Astro.cookies.set(cookie, expires + '.' + sign(expires), {
				httpOnly: true,
				secure: !import.meta.env.DEV,
				sameSite: 'strict',
				path: '/admin',
				maxAge: 3600,
			})
			return redirect('/admin', 303)
		}
		if (permitted) error = 'The email or password did not match.'
	} else {
		if (!signedIn) return new Response('Forbidden', { status: 403 })
		if (action === 'sign-out') {
			Astro.cookies.delete(cookie, { path: '/admin' })
			return redirect('/admin', 303)
		}
		if (typeof action === 'string' && ['create-subject', 'rename-subject', 'delete-subject'].includes(action)) {
			try {
				await editSubject(pool!, action, form)
				return redirect('/admin', 303)
			} catch (issue) {
				error = issue instanceof Error && !('code' in issue)
					? issue.message : 'The subject could not be saved.'
			}
		} else if (
			action === 'save-tutor' ||
			action === 'archive-tutor' ||
			action === 'restore-tutor'
		) {
			const id = String(form.get('tutor-id') ?? '')
			const existing = catalog.find(tutor => tutor.id === id)
			if (id && !existing) return new Response('Tutor not found', { status: 404 })
			const name =
				action === 'save-tutor'
					? String(form.get('name') ?? '').trim()
					: existing?.name
			const subjects =
				action === 'save-tutor'
					? form
							.getAll('subjects')
							.filter(
								(subject): subject is string =>
									typeof subject === 'string' && subjectNames.includes(subject),
							)
					: existing?.subjects
			const contactEmail = String(form.get('contact-email') ?? '').trim()
			const meetingInstructions = String(form.get('meeting-instructions') ?? '').trim()
			if (action === 'save-tutor' && contactEmail && (contactEmail.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(contactEmail)))
				error = 'Enter a valid tutor email address.'
			else if (action === 'save-tutor' && meetingInstructions.length > 4000)
				error = 'Meeting instructions must be 4,000 characters or fewer.'
			else if (!name || !subjects?.length)
				error = 'Enter a tutor name and choose at least one subject.'
			else {
				const tutorId = existing?.id ?? randomUUID()
				await pool!.query(
					'INSERT INTO tutor_profiles (tutor_id,name,subjects,archived,meeting_instructions,contact_email) VALUES ($1,$2,$3,$4,$5,$7) ON CONFLICT (tutor_id) DO UPDATE SET name=EXCLUDED.name, subjects=EXCLUDED.subjects, archived=EXCLUDED.archived, meeting_instructions=CASE WHEN $6 THEN EXCLUDED.meeting_instructions ELSE tutor_profiles.meeting_instructions END, contact_email=CASE WHEN $6 THEN EXCLUDED.contact_email ELSE tutor_profiles.contact_email END',
					[
						tutorId,
						name,
						subjects,
						action === 'archive-tutor' ||
							(action === 'save-tutor' && !!existing?.archived),
						meetingInstructions,
						action === 'save-tutor',
						contactEmail || null,
					],
				)
				return redirect(
					'/admin?tutor=' + encodeURIComponent(tutorId) + '#tutors-admin',
					303,
				)
			}
		} else if (
			[
				'create-booking',
				'mark-booking-paid',
				'edit-booking',
				'delete-booking',
				'move-session',
				'save-session-subject',
			].includes(String(action))
		) {
			try {
				if (
					action === 'create-booking' &&
					!catalog.some(
						tutor => tutor.id === form.get('booking-tutor') && !tutor.archived,
					)
				)
					throw new Error('Choose an active tutor.')
				await editBooking(pool!, form, String(action))
				const returnTutor = form.get('return-tutor')
				return redirect(
					['move-session', 'save-session-subject'].includes(String(action)) &&
						typeof returnTutor === 'string'
						? '/admin?open-tutor=' +
								encodeURIComponent(returnTutor) +
								'#tutors-admin'
						: '/admin#bookings-admin',
					303,
				)
			} catch (issue) {
				error =
					issue instanceof Error && !('code' in issue)
						? issue.message
						: 'The booking could not be updated.'
			}
		} else if (
			!selected ||
			!catalog.some(tutor => tutor.id === Astro.url.searchParams.get('tutor'))
		)
			return new Response('Tutor not found', { status: 404 })
		else if (action === 'reset') {
			await pool!.query('DELETE FROM tutor_weekly_hours WHERE tutor_id = $1', [
				selected.id,
			])
		} else if (action === 'save') {
			let invalid = false
			const starts = days.map((_, day) => {
				const starts = form.getAll('start-' + day)
				const ends = form.getAll('end-' + day)
				if (starts.length !== ends.length) invalid = true
				return starts.flatMap((value, index) => {
					const start = Number(value)
					const end = Number(ends[index])
					if (!times.includes(start) || !times.includes(end) || end - start < 60) {
						invalid = true
						return []
					}
					return Array.from(
						{ length: (end - start - 60) / 15 + 1 },
						(_, i) => start + i * 15,
					)
				})
			})
			if (invalid) {
				error = 'Each block needs at least one hour. Check its start and end times.'
			} else {
				await pool!.query(
					'INSERT INTO tutor_weekly_hours VALUES ($1, $2) ON CONFLICT (tutor_id) DO UPDATE SET starts_by_day = EXCLUDED.starts_by_day',
					[
						selected.id,
						JSON.stringify(
							starts.map(day => [...new Set(day)].sort((a, b) => a - b)),
						),
					],
				)
			}
		} else return new Response('Invalid action', { status: 400 })
		if (!error && selected)
			return redirect(
				'/admin?tutor=' +
					encodeURIComponent(selected.id) +
					'&saved=1#schedules-admin',
				303,
			)
	}
}
const bookings = signedIn
	? (
			await pool!.query<{
				id: string
				confirmed_at: Date
				package_hours: number | null
				label: string | null
				subtotal_cents: number | null
				discount_cents: number | null
				payment_pending: boolean
				contact_email: string | null
				contact_phone: string | null
				sessions: {
					id: string
					tutor: string
					subject: string | null
					start: string
				}[]
			}>(`SELECT b.id, b.confirmed_at, b.package_hours, b.label, b.subtotal_cents, b.discount_cents, b.payment_pending, b.contact_email, b.contact_phone,
  COALESCE(json_agg(json_build_object('id', s.id::text, 'tutor', s.tutor_id, 'subject', s.subject, 'start', lower(s.slot))
  ORDER BY lower(s.slot)) FILTER (WHERE s.id IS NOT NULL), '[]') AS sessions
  FROM booking_reservations b LEFT JOIN booking_sessions s ON s.reservation_id=b.id
  WHERE confirmed_at IS NOT NULL GROUP BY b.id ORDER BY confirmed_at DESC`)
		).rows
	: []
const reportDate = new Intl.DateTimeFormat('en-CA', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
	timeZone: 'America/New_York',
})
const easternTime = new Intl.DateTimeFormat('en-GB', {
	hour: '2-digit',
	minute: '2-digit',
	hourCycle: 'h23',
	timeZone: 'America/New_York',
})
const eastern = new Intl.DateTimeFormat('en-US', {
	dateStyle: 'medium',
	timeStyle: 'short',
	timeZone: 'America/New_York',
})
const data = {
	tutors: catalog.map(tutor => ({
		...tutor,
		contactEmail: instructions.get(tutor.id)?.contact_email ?? '',
		meetingInstructions: instructions.get(tutor.id)?.meeting_instructions ?? '',
		blocks: tutor.startsByDay.flatMap((starts, day) =>
			blocks(starts).map(block => ({ ...block, day })),
		),
	})),
	subjects: subjectNames,
	bookings: bookings.map(booking => ({
		id: booking.id,
		name: booking.label ?? 'Contact unrecorded',
		date: reportDate.format(booking.confirmed_at),
		hours: booking.package_hours ?? 0,
		subtotal: booking.subtotal_cents,
		discount: booking.discount_cents,
		paymentPending: booking.payment_pending,
		contactEmail: booking.contact_email,
		contactPhone: booking.contact_phone,
		sessions: booking.sessions.map(session => ({
			...session,
			subject: session.subject ?? '',
			date: reportDate.format(new Date(session.start)),
			time: easternTime.format(new Date(session.start)),
			label: eastern.format(new Date(session.start)) + ' Eastern',
		})),
	})),
}
if (wantsJson) {
	if (error && (Astro.response.status === 429 || Astro.response.status === 503))
		return Response.json({ error }, { status: Astro.response.status, headers: Astro.response.headers })
	if (!signedIn)
		return Response.json(
			{ error: 'Your session expired. Sign in again to continue.' },
			{ status: 401 },
		)
	if (error) return Response.json({ error }, { status: 400 })
	return Response.json(data)
}
---

<!doctype html>
<html lang='en'>
	<head>
		<meta charset='utf-8' />
		<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
		<meta name='viewport' content='width=device-width' />
		<meta name='robots' content='noindex, nofollow' />
		<title>Administration | MyChristianTutors</title>
	</head>
	<body class='admin-page min-h-screen bg-slate-50 text-slate-900'>
		<p class='border-b border-slate-200 bg-white px-4 py-1.5 text-center text-xs font-semibold text-slate-700'>
			{import.meta.env.PUBLIC_BUILD_LABEL}
		</p>
		{signedIn && timeTravelDemo && (
			<nav aria-label="Debugging" class="flex flex-wrap justify-center gap-4 border-b border-slate-200 bg-white px-4 py-2 text-xs text-teal-800">
				<a class="underline" href="/admin?timetravel=1">Debug admin</a>
				<a class="underline" href="/?timetravel=1#booking">Debug planner</a>
			</nav>
		)}
		{
			signedIn ? (
				<>
					<div id='tutoring-admin' data-timetravel={timeTravelDemo && Astro.url.searchParams.get('timetravel') === '1' ? '1' : undefined}>
						<p class='p-6'>Loading administration…</p>
					</div>
					<script
						id='admin-data'
						type='application/json'
						set:html={JSON.stringify(data).replace(/</g, '\\u003c')}
					/>
				</>
			) : (
				<main class='mx-auto mt-10 max-w-sm rounded-2xl border border-slate-200 bg-white p-6 shadow-sm max-sm:mx-4 sm:mt-20'>
					<a href='/' class='text-sm font-semibold text-teal-800 hover:underline'>
						MyChristianTutors
					</a>
					<h1 class='text-2xl font-semibold my-5'>Admin sign in</h1>
					{error && (
						<p role='alert' class='mb-4 rounded-lg bg-rose-50 p-3 text-sm text-rose-800'>
							{error}
						</p>
					)}
					<form method='post' class='grid gap-4'>
						<label>
							Email
							<input
								class='mt-1 block min-h-10 w-full rounded-lg border border-slate-300 bg-white px-3 py-2'
								name='email'
								type='email'
								autocomplete='username'
								required
							/>
						</label>
						<label>
							Password
							<input
								class='mt-1 block min-h-10 w-full rounded-lg border border-slate-300 bg-white px-3 py-2'
								name='password'
								type='password'
								autocomplete='current-password'
								required
							/>
						</label>
						<button
							class='min-h-10 rounded-lg bg-teal-800 px-4 py-2 font-semibold text-white hover:bg-teal-900'
							name='action'
							value='sign-in'
						>
							Sign in
						</button>
					</form>
				</main>
			)
		}
		<noscript
			><p class='p-4'>Enable JavaScript to manage tutors and bookings.</p></noscript
		>
		<script>
			import { main } from '../../planner/build/dev/javascript/christian_tutors_planner/christian_tutors_admin.mjs'
			const root = document.querySelector<HTMLElement>('#tutoring-admin')
			if (root) {
				if (import.meta.env.DEV) {
					void import('../../planner/build/dev/javascript/christian_tutors_planner/tutors_debug.mjs')
						.then(debug => debug.start_admin())
				} else {
					main()
				}
			}
		</script>
	</body>
</html>
<style is:global>
	body.admin-page {
		font-family: system-ui, sans-serif;
		color-scheme: light;
	}
	body.admin-page :is(h1, h2, h3, h4) {
		font-family: inherit;
		letter-spacing: normal;
	}
	#tutoring-admin {
		--font-sans: system-ui, sans-serif;
	}
	#tutoring-admin summary {
		padding: 0;
	}
	#tutoring-admin details > form {
		margin-top: 0.75rem;
	}
	#tutoring-admin label > :is(input, select) {
		margin-top: 0.375rem;
	}
	#tutoring-admin :is(input, select):focus-visible {
		outline: 2px solid #0f766e;
		outline-offset: 2px;
	}
	#tutoring-admin button:disabled {
		opacity: 0.45;
	}
</style>
