<script>
  for (const picker of document.querySelectorAll<HTMLSelectElement>('[data-tutor-picker]')) {
    picker.addEventListener('change', () => picker.form?.requestSubmit())
  }

  const subjectFilter = document.querySelector<HTMLSelectElement>('[data-subject-filter]')
  subjectFilter?.addEventListener('change', () => {
    let matches = 0
    for (const profile of document.querySelectorAll<HTMLElement>('[data-tutor-subjects]')) {
      const subjects: string[] = JSON.parse(profile.dataset.tutorSubjects!)
      profile.hidden = !!subjectFilter.value && !subjects.includes(subjectFilter.value)
      if (!profile.hidden) matches++
    }
    document.querySelector<HTMLElement>('[data-no-tutors]')!.hidden = matches > 0
  })

  const links = document.querySelectorAll<HTMLAnchorElement>('.admin-nav a')
  const views = [...document.querySelectorAll<HTMLElement>('[data-admin-view]')]

  function showSection(focusHeading = false) {
    const requested = window.location.hash.slice(1)
    const active = views.find(view => view.dataset.adminView === requested) ?? views.find(view => view.dataset.adminView === 'tutors-admin')
    if (!active) return
    for (const view of views) view.hidden = view !== active
    for (const link of links) {
      if (link.hash === '#' + (['add-tutor', 'schedules-admin'].includes(active.dataset.adminView ?? '') ? 'tutors-admin' : active.dataset.adminView)) link.setAttribute('aria-current', 'page')
      else link.removeAttribute('aria-current')
    }
    if (focusHeading) {
      const heading = active.querySelector('h2')
      heading?.setAttribute('tabindex', '-1')
      heading?.focus({ preventScroll: true })
      window.scrollTo(0, 0)
    }
  }

  for (const link of document.querySelectorAll<HTMLAnchorElement>('.admin-nav a, [data-admin-link]')) {
    link.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
      event.preventDefault()
      if (window.location.hash !== link.hash) history.pushState(null, '', link.hash)
      showSection(true)
    })
  }
  showSection()
  window.addEventListener('hashchange', () => showSection(true))
</script>

<script>
  const report = document.querySelector<HTMLElement>('[data-report]')
  if (report) {
    const rows: { date: string; customer: string | null; hours: number | null; subtotal: number | null; discount: number | null }[] =
      JSON.parse(report.dataset.report!)
    const from = report.querySelector<HTMLInputElement>('[data-report-from]')!
    const to = report.querySelector<HTMLInputElement>('[data-report-to]')!
    const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' })

    function renderReport() {
      const invalid = !!from.value && !!to.value && from.value > to.value
      report!.querySelector<HTMLElement>('[data-report-error]')!.hidden = !invalid
      const matching = invalid ? [] : rows.filter(row =>
        (!from.value || row.date >= from.value) && (!to.value || row.date <= to.value),
      )
      const complete = matching.filter(row => row.subtotal !== null && row.discount !== null)
      report!.querySelector('[data-revenue]')!.textContent =
        usd.format(complete.reduce((sum, row) => sum + row.subtotal! - row.discount!, 0) / 100)
      report!.querySelector('[data-discounts]')!.textContent =
        usd.format(matching.reduce((sum, row) => sum + (row.discount ?? 0), 0) / 100)
      report!.querySelector('[data-booking-count]')!.textContent = String(matching.length)
      const missing = matching.length - complete.length
      report!.querySelector('[data-unrecorded]')!.textContent = missing
        ? 'Bookings missing payment amounts: ' + missing
        : ''
      const packages = [5, 10, 20, null].map(hours =>
        (hours === null ? 'No package recorded' : hours + ' hours') + ' · ' +
        matching.filter(row => row.hours === hours).length,
      )
      const customers = new Map<string, number>()
      for (const row of matching) {
        if (row.customer) customers.set(row.customer, (customers.get(row.customer) ?? 0) + 1)
      }
      const contacts = [...customers].sort(([a], [b]) => a.localeCompare(b)).map(([name, count]) => name + ' · ' + count)
      for (const [selector, values] of [['[data-package-counts]', packages], ['[data-customers]', contacts.length ? contacts : ['No booking contacts in this range.']]] as const) {
        report!.querySelector(selector)!.replaceChildren(...values.map(value => {
          const item = document.createElement('li')
          item.textContent = value
          return item
        }))
      }
    }

    from.addEventListener('change', renderReport)
    to.addEventListener('change', renderReport)
    renderReport()
  }
</script>
