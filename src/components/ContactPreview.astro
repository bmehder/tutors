<details data-message-preview hidden class="mt-4 rounded-lg border border-ink/15 p-4 text-sm">
  <summary class="cursor-pointer font-semibold">View email draft</summary>
  <dl class="mt-2 space-y-1">
    <div><dt class="inline font-semibold">To</dt> <dd class="inline" data-preview-recipient></dd></div>
    <div><dt class="inline font-semibold">Subject</dt> <dd class="inline" data-preview-subject></dd></div>
  </dl>
  <p data-preview-text class="mt-3 whitespace-pre-wrap break-words text-ink/80"></p>
</details>
