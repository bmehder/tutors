---
import './booking.css'
---

<section id="booking" class="bg-[#f0f2eb] border-y border-ink/10 py-14 md:py-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-8">
    <p class="eyebrow text-ink/55 mb-3">Plan your tutoring</p>
    <h2 class="text-4xl md:text-5xl font-semibold">Time for each student.<br /><span class="serif">A plan for your whole family.</span></h2>
    <p class="text-sm leading-7 text-ink/65 mt-5 mb-3 max-w-xl">Choose a package, add your students and subjects, then pick weekly tutoring times that fit your family.</p>
    <div id="family-planner" class="scroll-mt-6"><p class="text-sm py-4">Loading the family planner…</p></div>
    <noscript><p>Please enable JavaScript to use the family planner.</p></noscript>
  </div>
</section>
<script>
  import { main } from '../../../planner/build/dev/javascript/christian_tutors_planner/christian_tutors_planner.mjs';
  import { loadTutorHours } from '../../../planner/build/dev/javascript/christian_tutors_planner/planner_ffi.mjs';
  loadTutorHours().then(async () => {
    const requested = import.meta.env.PUBLIC_TIMETRAVEL_DEMO
      && new URLSearchParams(location.search).get('timetravel') === '1';
    if (import.meta.env.DEV || requested) {
      const debug = await import('../../../planner/build/dev/javascript/christian_tutors_planner/tutors_debug.mjs');
      debug.start_planner();
    } else {
      main();
    }
  }).catch(() => {
    document.querySelector('#family-planner p')!.textContent = 'Tutor schedules could not be loaded. Please refresh to try again.';
  });
</script>
