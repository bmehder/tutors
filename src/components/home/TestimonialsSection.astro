---
const names = ['Parent', 'Michael T.', 'Rebecca S.']
const testimonials = [
	'[Student] exempted out of her end of year Geometry exam because of your help and ended up with a 95 in the class! Thank you so much for your help!',
	'Donec vitae sapien ut libero venenatis faucibus. Sed consequat, leo eget bibendum sodales, augue velit cursus nunc.',
	'Vestibulum ante ipsum primis in faucibus orci luctus et ultrices posuere cubilia curae. Nulla facilisi. Fusce ac felis sit amet ligula pharetra condimentum.',
]
---

<section
	aria-labelledby='testimonials-heading'
	class='mx-auto max-w-7xl px-6 py-12 md:px-12 md:py-16'
>
	<h2 id='testimonials-heading' class='mb-8 text-3xl font-semibold md:text-4xl'>
		More confidence. <span class='serif'>For the whole family.</span>
	</h2>
	<div class='grid gap-5 md:grid-cols-3 md:gap-6'>
		{testimonials.map((quote, index) => (
			<figure class='rounded-xl border border-ink/15 bg-white p-6 md:p-7 flex flex-col'>
				<span aria-hidden='true' class='serif block h-10 text-6xl leading-none text-coral'>“</span>
				<blockquote class='mt-3 flex-1 text-sm leading-7 text-ink/80'>{quote}</blockquote>
				<figcaption class='mt-6 flex items-center gap-3 border-t border-ink/10 pt-4'>
					<span aria-hidden='true' class='serif grid size-10 place-items-center rounded-full bg-[#eaf0e9] text-xl'>
						{names[index][0]}
					</span>
					<span class='text-sm font-semibold'>{names[index]}</span>
				</figcaption>
			</figure>
		))}
	</div>
</section>
