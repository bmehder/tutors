---
import TutorCard from '../tutors/TutorCard.astro'
const { tutors } = Astro.props
---
<section id="tutors" class="border-y border-ink/10 bg-[#f0f2eb] py-20">
  <div class="mx-auto max-w-7xl px-6 md:px-12">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-xl">
        <p class="eyebrow mb-3 text-ink/55">A teacher. A mentor. An encourager.</p>
        <h2 class="text-4xl font-semibold">People with a <span class="serif">heart for teaching.</span></h2>
      </div>
      <a class="btn" href="/tutors">Explore all tutors</a>
    </div>
    {tutors.length > 0 && (
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {tutors.map((tutor: { id: string; name: string; subjects: string[]; profileSlug: string }) => <TutorCard tutor={tutor} featured />)}
      </ul>
    )}
  </div>
</section>
