---
import Icon from '../Icon.astro';
---
<section id="offer" aria-labelledby="offer-heading" class="max-w-7xl mx-auto px-6 md:px-12 py-12 md:py-16">
  <div class="bg-[#f5e8e1] border border-ink/10 rounded-2xl p-6 sm:p-8 md:p-12 grid md:grid-cols-2 items-center gap-8 md:gap-12">
    <div>
      <p class="eyebrow mb-4">A warm welcome for your family</p>
      <h2 id="offer-heading" class="text-3xl md:text-4xl font-semibold">Your first session.<br /><span class="serif">Our welcome gift.</span></h2>
      <p class="mt-5 leading-7 max-w-md text-ink/75">New to MyChristianTutors? Join our mailing list for one free tutoring session, plus helpful news and encouragement for your family.</p>
      <p class="text-sm mt-3 text-ink/65">For new customers · One free session per family</p>
    </div>
    <div>
      <div hidden data-signup-confirmation role="status" class="bg-white/70 rounded-xl p-7">
        <Icon name="CheckCircle2" class="mb-4" />
        <h3 class="text-xl font-semibold">A warm welcome awaits.</h3>
        <p class="text-sm mt-3 leading-6">This previews the welcome message for your family’s free first tutoring session. Your email has not been saved.</p>
      </div>
      <form data-newsletter-signup>
        <label for="newsletter-email" class="text-sm font-semibold">Your email address</label>
        <div class="flex flex-col gap-3 mt-2">
          <input id="newsletter-email" name="email" type="email" autocomplete="email" required class="field min-w-0" placeholder="you@example.com" />
          <button class="btn w-full sm:w-auto sm:self-start">Get my free session</button>
        </div>
        <label class="flex gap-2 mt-4 text-xs leading-5">
          <input type="checkbox" required class="mt-1 accent-[#143f3c]" />
          I’d like to receive MyChristianTutors news and offers. I can unsubscribe anytime.
        </label>
        <p class="text-xs text-ink/65 mt-3">Signup preview · Your email is not saved or sent.</p>
      </form>
    </div>
  </div>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter-signup]');
  const confirmation = document.querySelector<HTMLElement>('[data-signup-confirmation]');
  form?.addEventListener('submit', event => {
    event.preventDefault();
    form.reset();
    form.hidden = true;
    if (confirmation) confirmation.hidden = false;
  });
</script>
