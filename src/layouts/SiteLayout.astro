---
import "../index.css";
import { canonicalUrl, structuredDataJson } from '../lib/seo';
import { robotsDirective } from '../lib/search-indexing';

const siteName = "MyChristianTutors";
const { title, description = 'One-on-one Christian online tutoring for homeschool families. Choose subjects and tutors, share package hours across your family, and plan weekly sessions.', structuredData = [], indexable = true } = Astro.props;
const siteTitle = title ? `${title} | ${siteName}` : `Christian Online Tutoring for Homeschool Families | ${siteName}`;
const canonical = canonicalUrl(Astro.url.pathname);
---
<!doctype html>
<html lang="en" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="robots" content={robotsDirective(indexable)} />
    <meta name="description" content={description} />
    <slot name="head" />
    {structuredData.length > 0 && <script type="application/ld+json" set:html={structuredDataJson({ '@context': 'https://schema.org', '@graph': structuredData })} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#143f3c" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400&family=Nunito:wght@400..800&display=swap" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://www.mychristiantutors.com/images/my-christian-tutors-social.png" />
    <meta property="og:image:secure_url" content="https://www.mychristiantutors.com/images/my-christian-tutors-social.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MyChristianTutors. Grow in knowledge. Grounded in faith. One-on-one online tutoring with a Biblical worldview." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.mychristiantutors.com/images/my-christian-tutors-social.png" />
    <meta name="twitter:image:alt" content="MyChristianTutors. Grow in knowledge. Grounded in faith." />
  </head>
  <body>
    <slot />
    <button
      type="button"
      hidden
      data-back-to-top
      class="fixed right-4 bottom-4 z-30 min-h-11 rounded-full border border-white/30 bg-ink px-4 text-sm font-bold text-white shadow-lg hover:bg-[#245a54] focus-visible:outline-2 focus-visible:outline-ink sm:right-6 sm:bottom-6 print:hidden"
    >
      <span aria-hidden="true">↑</span> Back to top
    </button>
    <script>
      const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
      if (backToTop) {
        const updateVisibility = () => {
          backToTop.hidden = window.scrollY < window.innerHeight;
        };

        window.addEventListener('scroll', updateVisibility, { passive: true });
        window.addEventListener('resize', updateVisibility);
        backToTop.addEventListener('click', () => {
          const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reducedMotion ? 'instant' : 'smooth' });
        });
        updateVisibility();
      }
    </script>
  </body>
</html>
