# Email settings to add alongside the app's existing private environment values.
# Copy values into .env.local locally and Vercel's environment settings for hosting.
RESEND_API_KEY=
EMAIL_WORKER_SECRET=
EMAIL_DELIVERY_ENABLED=0
TUTOR_EMAIL_DELIVERY_ENABLED=0
SANDBOX_ORDER_EMAIL_DELIVERY_ENABLED=0

# Test discounts are opt-in and are never honored by live checkout.
SANDBOX_DISCOUNTS_ENABLED=0
# Optional separate HMAC key for short-lived request-limit identities.
# Defaults to BOOKING_ADMIN_SIGNING_KEY when omitted.
REQUEST_LIMIT_SIGNING_KEY=
# Apply db/014-request-limits.sql before enabling in that environment.
REQUEST_LIMITS_ENABLED=0
